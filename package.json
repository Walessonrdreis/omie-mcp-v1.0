{
  "name": "omie-mcp",
  "version": "0.1.0",
  "description": "Servidor MCP para integração com a API da Omie (Chão de Fábrica e demais módulos)",
  "type": "module",
  "main": "dist/index.js",
  "bin": {
    "omie-mcp": "dist/index.js"
  },
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "start": "node dist/index.js",
    "start:http": "node dist/httpServer.js",
    "dev": "tsx src/index.ts",
    "dev:http": "tsx src/httpServer.ts"
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.12.0",
    "dotenv": "^16.4.5",
    "express": "^5.2.1",
    "zod": "^3.23.8",
    "zod-to-json-schema": "^3.25.2"
  },
  "devDependencies": {
    "@types/express": "^5.0.6",
    "@types/node": "^20.14.2",
    "tsx": "^4.16.2",
    "typescript": "^5.5.3"
  }
}
